# The starter uses a local SQLite database and the Bandcamp demo catalogue.
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=data/store.sqlite
SEED_DEMO=true
SHOP_CURRENCY=EUR
PUBLIC_STORE=false

# Set your public HTTPS origin before enabling live checkout.
# SHOP_ORIGIN=https://shop.example.com

# Use an independently generated random key of at least 24 characters for /admin.
# ADMIN_ACCESS_KEY=

# Stripe test and live environments use separate keys and webhook secrets.
ENABLE_CHECKOUT=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SHIPPING_RATES={"DE":650,"AT":750}

# Optional actual label contact address and merchant details.
# LEGAL_NAME=
# LEGAL_ADDRESS=
